NODE_ENV=development

POSTGRES_USER=viphost
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=viphost_db

REDIS_PASSWORD=your_secure_redis_password_here

JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=3000

DATABASE_URL=postgresql://viphost:your_secure_postgres_password_here@localhost:5432/viphost_db

REDIS_HOST=localhost
REDIS_PORT=6379

CORS_ORIGIN=*

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_DEFAULT_MODEL=anthropic/claude-3-haiku
AI_MAX_TOKENS=4096
AI_TIMEOUT=60000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

VITE_API_URL=/api
